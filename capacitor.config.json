{
  "appId": "fr.secoto.app",
  "appName": "SECOTO",
  "webDir": "dist",
  "backgroundColor": "#060b16",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#060b16"
  },
  "android": {
    "backgroundColor": "#060b16"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "banner",
        "list"
      ]
    },
    "Keyboard": {
      "resize": "native"
    },
    "StatusBar": {
      "overlaysWebView": true
    }
  }
}
